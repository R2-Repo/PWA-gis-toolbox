# Copy to .env or .env.local (never commit real keys).
# UGRC browser API key for the public PWA build.
# Create at https://developer.mapserv.utah.gov — use a Browser key with
# referrer patterns for production, staging, and localhost (Development).
VITE_UGRC_API_KEY=

# Optional: for GitHub Actions Pages deploy, add a repository secret named
# VITE_UGRC_API_KEY and wire it into .github/workflows/deploy-pages.yml
# build steps as:
#   env:
#     VITE_UGRC_API_KEY: ${{ secrets.VITE_UGRC_API_KEY }}
