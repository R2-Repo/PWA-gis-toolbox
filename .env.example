# Copy to .env or .env.local (never commit real keys).
# UGRC browser API key for the public PWA build.
# Create at https://developer.mapserv.utah.gov — use a Browser key with
# referrer patterns for your Cloudflare Pages host(s) and localhost (Development).
VITE_UGRC_API_KEY=

# CARTO vector basemap key (Voyager / Dark Matter / Positron).
# Request at https://carto.com/basemaps/apikey — no CARTO account required.
VITE_CARTO_API_KEY=

# Cloudflare Pages (PWA host):
# Workers & Pages → your project → Settings → Environment variables
# Add VITE_UGRC_API_KEY and VITE_CARTO_API_KEY for Production and Preview, then Redeploy.
