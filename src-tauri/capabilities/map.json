{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "map-window",
  "description": "Dual Screen secondary map window — close/focus/zoom only (cannot spawn more webviews)",
  "windows": ["map"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
